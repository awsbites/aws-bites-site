{
  "name": "aws-bites-site",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "npm-run-all --parallel start:eleventy start:tailwind",
    "start:eleventy": "eleventy --serve",
    "start:tailwind": "tailwindcss -i src/_includes/styles/tailwind.css -o dist/style.css --watch",
    "clean": "rimraf dist",
    "build": "npm-run-all build:tailwind build:eleventy",
    "build:eleventy": "NODE_ENV=production ELEVENTY_PRODUCTION=true eleventy",
    "build:tailwind": "NODE_ENV=production tailwindcss -i src/_includes/styles/tailwind.css -o dist/style.css",
    "check": "biome lint .",
    "format": "biome check --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-fetch": "^5.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "axios": "^1.16.1",
    "eleventy-plugin-youtube-embed": "^1.13.2",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "luxon": "^3.7.2",
    "node-webvtt": "^1.9.4",
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.5.2",
    "rimraf": "^6.1.3",
    "striptags": "^3.2.0",
    "tailwindcss": "^4.3.0",
    "yargs": "^18.0.0"
  }
}
