---
title: "AWS Bites podcast - page not found"
is_generic: false
eleventyExcludeFromCollections: true
permalink: 404.html
---

{% extends 'base.njk' %}

{% block body_class_extra %}not-found-page{% endblock %}
{% block footer_background %}{% endblock %}

{% block body_content %}
  <main id="main-content" tabindex="-1" class="text-gray-900 dark:text-gray-100">
    <section aria-labelledby="not-found-title">
      <div class="max-w-6xl mx-auto px-6 py-10 sm:py-14 lg:py-16 grid items-center gap-10 md:grid-cols-[1.25fr_1fr] md:gap-12">
        <div>
          <h1 id="not-found-title" class="not-found-heading">Oops... a <span class="not-found-code text-primary-700 dark:text-secondary-100">404!</span></h1>
          <p class="not-found-message mt-6 text-lg sm:text-xl leading-relaxed">
            This cloud <em class="text-primary-700 dark:text-secondary-100">strikes</em> me as a happy one, but it doesn't have the page you're looking for.
          </p>
          <p class="not-found-recovery mt-4 text-base leading-relaxed">
            Try the search bar above, or head back to the <a class="font-semibold text-primary-700 dark:text-secondary-100 hover:decoration-2 underline underline-offset-4" href="/">home page</a>.
          </p>
        </div>
        <figure class="not-found-cloud mx-auto w-full max-w-xs">
          <a href="/" aria-label="Go back to the home page" class="block rounded-xl">
            <img class="w-full rounded-xl" src="/cloud404.gif" width="480" height="480" alt="Happy cloud GIF with lightning"/>
          </a>
          <figcaption class="not-found-credit mt-3 text-xs leading-relaxed">
            Lightning Strike Cloud GIF by <a class="text-primary-700 dark:text-secondary-100 hover:decoration-2 underline underline-offset-4" target="_blank" rel="noopener noreferrer" href="https://giphy.com/gifs/storms-lightning-strike-stormy-weather-RNveokQhEObpqyvYb5">Kev Lavery</a>
          </figcaption>
        </figure>
      </div>
    </section>
    {% set latestEpisode = collections.publishedEpisodes | last %}
    {% if latestEpisode %}
    <section aria-labelledby="not-found-latest" class="max-w-6xl mx-auto px-6 pt-8 sm:pt-10">
      <h2 id="not-found-latest" class="text-sm text-gray-600 dark:text-gray-300">Or jump into our latest episode</h2>
      <a href="{{ latestEpisode.url }}" class="not-found-latest-link mt-2 inline-flex items-start gap-3 py-2 text-xl sm:text-2xl font-semibold leading-snug text-primary-700 dark:text-secondary-100 hover:underline underline-offset-4">
        <span>{{ latestEpisode.data.episode }}. {{ latestEpisode.data.title }}</span>
        <svg class="shrink-0 mt-1" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
      </a>
    </section>
    {% endif %}
  </main>
{% endblock body_content %}
